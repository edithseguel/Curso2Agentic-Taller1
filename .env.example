# Clave de Gemini; debe copiarse a .env y nunca escribirse en el código.
GOOGLE_API_KEY=
# Modelo de Gemini que utilizarán los agentes.
MODELO=gemini-3.5-flash-lite
# Valor HH en UF
vhorahom=
# Tarifas horarias UF por perfil para Edith; la tarifa mensual es valor hora × 120.
vh_perf_prog=
vh_perf_progfs=
vh_perf_dba=
vh_perf_prognet=
vh_perf_qa=
vh_perf_analis=
# URL donde escuchará el agente de cotizaciones de Outsourcing TI.
URL_OUTSOURCING=http://127.0.0.1:8001
# URL donde escuchará el agente de cotizaciones de Desarrollo TI.
URL_DESARROLLO=http://127.0.0.1:8002
# URL donde escuchará el agente de cotizaciones de Minería de Datos.
URL_MINERIA=http://127.0.0.1:8003
# URL donde escuchará el coordinador.
URL_COORDINADOR=http://127.0.0.1:8004
# URLs alternativas con el nombre específico de cada agente. Si se definen,
# tienen prioridad sobre las URL anteriores.
URL_EDITH_OUTSOURCING_TI=http://127.0.0.1:8001
URL_CRISTIAN_DESARROLLO_TI=http://127.0.0.1:8002
URL_RODRIGO_MINERIA_DE_DATOS=http://127.0.0.1:8003
